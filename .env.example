# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://legalcore:change-me@db:5432/legalcore

# --- API ---
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=true
CORS_ORIGINS=["https://legalcore.in"]

# First super admin, created on first start if none exists
ADMIN_EMAIL=admin@legalcore.in
ADMIN_PASSWORD=
ADMIN_NAME=Legal Core Admin

# --- Website (optional head-office contact details; empty shows a placeholder) ---
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_HOURS=
# Grievance officer shown on the Privacy Notice (DPDP Act 2023)
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_GRIEVANCE_EMAIL=

# --- Uploads ---
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=10
# Virus scanning through a ClamAV daemon. Leave empty to mark files "not scanned".
CLAMD_HOST=
CLAMD_PORT=3310

# --- Notifications (leave empty if not set up; the system records "not configured" and never pretends to send) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Demo site only (never in production) ---
# DEMO_MODE shows the demo banner and, when no email/SMS is set up, shows tracking codes on screen.
DEMO_MODE=false
# Password for the fictional demo users. Keep it private. If empty, a random one is printed to the server log.
DEMO_PASSWORD=
# The demo administrator stays disabled unless this is true. Never enable it on a public site.
DEMO_ADMIN_ENABLED=false
