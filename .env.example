# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://legalcore:change-me@db:5432/legalcore

# --- API ---
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=true
CORS_ORIGINS=["https://legalcore.in"]

# First super admin, created on first start if none exists
ADMIN_EMAIL=admin@legalcore.in
ADMIN_PASSWORD=
ADMIN_NAME=Legal Core Admin

# --- Website (optional head-office contact details; empty shows a placeholder) ---
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
